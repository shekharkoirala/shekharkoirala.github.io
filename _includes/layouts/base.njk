<!doctype html>
<html lang="{{ metadata.language }}" data-theme="dark">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title or metadata.title }}{% if title %} | {{ metadata.title }}{% endif %}</title>
	<meta name="description" content="{{ description or metadata.description }}">
	<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">

	{#- Set theme before paint to avoid a flash of the wrong theme #}
	<script>
	(function() {
		try {
			var saved = localStorage.getItem('theme');
			var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
			document.documentElement.setAttribute('data-theme', theme);
		} catch (e) {}
	})();
	</script>

	<style>{% include "css/index.css" %}</style>
	<style>{% getBundle "css" %}</style>
</head>
<body class="{{ bodyClass }}">
	<a href="#main" id="skip-link" class="visually-hidden">Skip to main content</a>

	<div class="site-wrapper">
		<aside class="sidebar" id="sidebar">
			<div class="sidebar-header">
				<a href="/" class="site-title">{{ metadata.title }}</a>
				<p class="site-tagline">Personal Blog / Scribbles</p>
			</div>

			<nav class="sidebar-nav" aria-label="Categories">
				<div class="nav-section">
					<a href="/blog/"
					   class="category-link{% if page.url == '/blog/' %} active{% endif %}"
					   data-category="all">
						All Posts
					</a>
				</div>

				<div class="nav-section">
					<h3 class="nav-heading">Categories</h3>
					{%- for group in collections.categoryGroups %}
					<a href="/categories/{{ group | slugify }}/"
					   class="category-link{% if page.url == '/categories/' + (group | slugify) + '/' %} active{% endif %}"
					   data-category="{{ group | slugify }}">
						{{ group }}
					</a>
					{%- endfor %}
				</div>

				<div class="nav-divider"></div>

				<div class="nav-section">
					<a href="/about/" class="nav-page-link{% if page.url == '/about/' %} active{% endif %}">About / CV</a>
					<a href="/tags/" class="nav-page-link{% if page.url == '/tags/' %} active{% endif %}">Tags</a>
					<a href="/feed/feed.xml" class="nav-page-link">RSS</a>
				</div>

				<div class="sidebar-footer">
					<div class="social-links">
						<a href="https://github.com/shekharkoirala" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.11.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.53 11.53 0 0 0 23.5 12.02C23.5 5.74 18.27.5 12 .5Z"/></svg>
						</a>
						<a href="https://linkedin.com/in/shekharkoirala" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0Z"/></svg>
						</a>
						<a href="https://twitter.com/shekhar_koirala" target="_blank" rel="noopener" aria-label="X / Twitter" title="X / Twitter">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg>
						</a>
					</div>
					<button class="theme-toggle" id="themeToggle" aria-label="Toggle light/dark theme" title="Toggle theme">
						<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
						<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
						<span class="theme-label">Theme</span>
					</button>
				</div>
			</nav>
		</aside>

		<div class="content-area">
			<header class="top-bar">
				<button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">&#9776;</button>
				<a href="/" class="mobile-title">{{ metadata.title }}</a>
			</header>

			<main id="main" class="main-content">
				<heading-anchors>
					{{ content | safe }}
				</heading-anchors>
			</main>

			<footer class="site-footer">
				<p>© Shekhar Koirala &middot; <a href="/feed/feed.xml">RSS</a> &middot; Built with <a href="https://www.11ty.dev/">Eleventy</a></p>
			</footer>
		</div>
	</div>

	<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
	<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	<script>
	// Sidebar toggle (mobile)
	const sbToggle = document.getElementById('sidebarToggle');
	const sidebar = document.getElementById('sidebar');
	if (sbToggle && sidebar) {
		sbToggle.addEventListener('click', () => sidebar.classList.toggle('open'));
	}
	// Theme toggle
	const themeToggle = document.getElementById('themeToggle');
	if (themeToggle) {
		themeToggle.addEventListener('click', () => {
			const cur = document.documentElement.getAttribute('data-theme');
			const next = cur === 'light' ? 'dark' : 'light';
			document.documentElement.setAttribute('data-theme', next);
			try { localStorage.setItem('theme', next); } catch (e) {}
		});
	}
	</script>
</body>
</html>
